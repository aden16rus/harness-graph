# Environment & Local Secrets
.env
.env.*
!.env.example

# Runtime Data, Database & Logs
/data/*
!/data/.gitkeep
!/data/logs/
/data/logs/*
!/data/logs/.gitkeep

# Target Workspace runtime files
/workspace/*
