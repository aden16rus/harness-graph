/.npm-cache/

# Go
go-engine/bin/
go-engine/vendor/

# PHP
php-core/vendor/
php-core/composer.lock

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
